# MEMORA React Native / Expo Mobile App Environment Variables

# Backend API URL for Mobile Devices:
# In Expo development over Wi-Fi: Auto-detected via Constants.expoConfig.hostUri (http://<computer-ip>:5000/api)
# In Android Emulator: http://10.0.2.2:5000/api
# In iOS Simulator: http://localhost:5000/api
# In Production Build: https://api.memora.com/api
EXPO_PUBLIC_API_URL=

# Razorpay Public Key for Mobile Checkout
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
