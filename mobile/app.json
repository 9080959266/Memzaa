{
  "expo": {
    "name": "MEMORA",
    "slug": "memora-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "https://images.unsplash.com/photo-1516035069371-29a1b244cc32?auto=format&fit=crop&w=512&q=80",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.memora.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      },
      "package": "com.memora.app"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you customize personalized photo frames and photo albums."
        }
      ]
    ]
  }
}
