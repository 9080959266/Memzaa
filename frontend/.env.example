# MEMORA Web Frontend Environment Variables

# Backend API base URL
# In local development: Leave blank to use Vite reverse proxy (/api -> http://localhost:5000)
# In production: https://api.memora.com (or your hosted backend URL)
# For local device / mobile browser testing on same Wi-Fi: http://<your-computer-ip>:5000
VITE_API_URL=

# Razorpay Public Key (Safe for frontend exposure)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
